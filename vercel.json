{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "docs",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dictate",
      "destination": "/jot",
      "statusCode": 301
    },
    {
      "source": "/dictate/",
      "destination": "/jot",
      "statusCode": 301
    },
    {
      "source": "/dictate/:path+",
      "destination": "/jot/:path+",
      "statusCode": 301
    },
    {
      "source": "/mobile",
      "destination": "/jot",
      "statusCode": 301
    },
    {
      "source": "/mobile/",
      "destination": "/jot",
      "statusCode": 301
    },
    {
      "source": "/mobile/:path+",
      "destination": "/jot/:path+",
      "statusCode": 301
    },
    {
      "source": "/record",
      "destination": "/jot",
      "statusCode": 301
    },
    {
      "source": "/record/",
      "destination": "/jot",
      "statusCode": 301
    },
    {
      "source": "/record/:path+",
      "destination": "/jot/:path+",
      "statusCode": 301
    }
  ]
}
