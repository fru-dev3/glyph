.DS_Store

# Netlify CLI working directory: link state, and a vendored node_modules that
# has no business in a public repo for a one-file shell tool.
.netlify/

# local backups the updater leaves behind
*.bak

# Vercel link state
.vercel
.env*

# Private, and never in this public repo: project notes live in the
# owner's own storage, linked in per machine.
/.soul
__pycache__/

# accounts left out of the stargazer faces (local, never committed)
.stargazers-exclude

# site icons, copied from assets/family/ by scripts/sync-icons.sh (never edit or commit them)
/docs/family/
/docs/favicon.svg
/docs/favicon.ico
/docs/icon-192.png
/docs/icon-512.png
/docs/apple-touch-icon.png
